{
  "name": "myagent",
  "version": "0.1.0",
  "type": "module",
  "main": "dist/desktop/main.js",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "hanekawa": "./bin/hanekawa.mjs",
    "myagent-tui": "./bin/hanekawa.mjs"
  },
  "scripts": {
    "dev:tui": "tsx src/tui/entrypoints/tui.tsx",
    "build": "tsc -p tsconfig.build.json",
    "build:desktop": "tsc -p tsconfig.build.json && esbuild src/desktop/preload.ts --bundle --platform=node --format=cjs --target=node20 --outfile=dist/desktop/preload.js --external:electron && esbuild src/desktop/renderer/app.ts --bundle --platform=neutral --format=esm --target=chrome120 --main-fields= --alias:node:crypto=./src/desktop/renderer/runtime/nodeCryptoShim.ts --outfile=dist/desktop/renderer/app.js && node scripts/copy-desktop-assets.mjs",
    "start:desktop": "electron .",
    "smoke:desktop": "node scripts/smoke-desktop.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.preload.json && tsc --noEmit -p tsconfig.renderer.json && tsc --noEmit -p tsconfig.domtest.json",
    "test": "node --import tsx --test test/**/*.test.ts",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "latest",
    "@modelcontextprotocol/sdk": "latest",
    "cli-highlight": "^2.1.11",
    "diff": "^9.0.0",
    "fast-glob": "latest",
    "figures": "^6.1.0",
    "fuse.js": "^7.4.1",
    "ink": "7.0.6",
    "katex": "^0.18.6",
    "marked": "^18.0.3",
    "openai": "latest",
    "picomatch": "^2.3.2",
    "react": "^19.2.6",
    "turndown": "^7.2.0",
    "wrap-ansi": "^10.0.0",
    "yaml": "latest",
    "zod": "latest",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@types/diff": "^7.0.2",
    "@types/ink": "^0.5.2",
    "@types/node": "latest",
    "@types/react": "^19.2.14",
    "@types/turndown": "^5.0.5",
    "electron": "^43.4.0",
    "esbuild": "^0.28.2",
    "fast-check": "^3.23.2",
    "ink-testing-library": "^4.0.0",
    "patch-package": "^8.0.0",
    "tsx": "latest",
    "typescript": "7.0.2"
  }
}
